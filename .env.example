# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Application Environment
NODE_ENV=development

# Session Security
SESSION_SECRET=your-secure-session-secret-key-here

# Database Connection Details (Auto-generated from DATABASE_URL)
PGHOST=your-database-host
PGPORT=5432
PGUSER=your-database-username
PGPASSWORD=your-database-password
PGDATABASE=your-database-name

# Production Deployment (Optional)
REPLIT_DOMAINS=your-domain.com
REPL_ID=your-repl-id

# External API Keys (Optional - for enhanced features)
# PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key

# Development Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. DATABASE_URL is required for the application to work
# 4. SESSION_SECRET should be a random, secure string
# 5. For local development, you can use a local PostgreSQL or Neon database