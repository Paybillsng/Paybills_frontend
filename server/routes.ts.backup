      "description": "Professional Unity Pro 2024 game development platform with advanced features, cloud build, analytics, and collaboration tools. Perfect for creating 2D, 3D, VR, and AR games and experiences.",
      "originalDescription": "Unity Pro 2024 license",
      "price": "₦89,000",
      "priceAmount": "89000.00",
      "imageUrl": "https://images.unsplash.com/photo-1542751371-adc38448a05e?w=400&h=300&fit=crop",
      "category": "Gaming",
      "source": "esdcodes",
      "inStock": true,
      "createdAt": "2025-01-25T03:08:17.000Z",
      "updatedAt": "2025-01-25T03:08:17.000Z"
    }
  ];
  
  console.log(`Serving ${products.length} software products`);
  res.setHeader('Content-Type', 'application/json');
  res.json(products);
});

// Populate database with sample products
router.post('/api/software/populate', async (req, res) => {
  try {
    // Clear existing products first
    await db.delete(softwareProducts);
    
    const scraper = new ProductScraper();
    const products = scraper.getSampleProducts();
    
    // Store products in database
    const savedProducts = [];
    for (const product of products) {
      try {
        // Extract price amount from price string
        const priceMatch = product.price.match(/[\d,]+\.?\d*/);
        const priceAmount = priceMatch ? parseFloat(priceMatch[0].replace(/,/g, '')) : 0;
        
        const [savedProduct] = await db.insert(softwareProducts).values({
          title: product.title,
          description: product.description,
          originalDescription: product.originalDescription,
          price: product.price,
          priceAmount,
          imageUrl: product.imageUrl,
          category: product.category,
          source: 'esdcodes',
          inStock: product.inStock
        }).returning();
        
        savedProducts.push(savedProduct);
      } catch (insertError) {
        console.error('Error inserting product:', product.title, insertError);
      }
    }
    
    res.json({ 
      success: true, 
      message: `Successfully populated database with ${savedProducts.length} products`,
      products: savedProducts 
    });
  } catch (error) {
    console.error('Error during population:', error);
    res.status(500).json({ 
      success: false, 
      message: 'Failed to populate products',
      error: error.message 
    });
  }
});

// Trigger actual scraping (for admin use)
router.post('/api/software/scrape', async (req, res) => {
  try {
    const scraper = new ProductScraper();
    let scrapedProducts = await scraper.scrapeProducts();
    
    // If scraping fails or returns no products, use sample products
    if (scrapedProducts.length === 0) {
      console.log('Scraping returned no products, using sample products');
      scrapedProducts = scraper.getSampleProducts();
    }
    
    res.json({ 
      success: true, 
      message: `Successfully scraped ${scrapedProducts.length} products`,
      products: scrapedProducts,
      note: scrapedProducts === scraper.getSampleProducts() ? 'Used sample products due to scraping limitations' : 'Scraped from source'
    });
  } catch (error) {
    console.error('Error during scraping:', error);
    const scraper = new ProductScraper();
    res.json({ 
      success: true, 
      message: 'Scraping failed, returning sample products',
      products: scraper.getSampleProducts(),
      note: 'Fallback to sample products due to error'
    });
  }
});

